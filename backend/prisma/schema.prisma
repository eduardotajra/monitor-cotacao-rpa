generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Isso aqui substitui o CREATE TABLE manual
model HistoricoDolar {
  id           Int      @id @default(autoincrement())
  valor        String
  dataConsulta DateTime @default(now()) @map("data_consulta") // @map usa o nome snake_case no banco

  @@map("historico_dolar") // Nome da tabela no banco
}
